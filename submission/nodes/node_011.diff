+    def predict(self, X):
+        Xw = self.W[X]
+        Xv = self.V[X]
+        Xv_sum = Xv.sum(axis=1)
+        logits = self.b + Xw.sum(axis=1) + 0.5 * (np.square(Xv_sum).sum(axis=1) - np.square(Xv).sum(axis=(1, 2)))
+        return 1.0 / (1.0 + np.exp(-np.clip(logits, -20, 20)))
+
+    def step(self, X, y):
+        pred = self.predict(X)
+        grad = (pred - y).astype(np.float32)
+        self.b -= self.lr * grad.mean()
+        # Pointwise update (similar to baseline)
+        self.W[X] -= self.lr * grad[:, None]
+        Xv = self.V[X]
+        Xv_sum = Xv.sum(axis=1)
+        self.V[X] -= self.lr * grad[:, None, None] * (Xv_sum[:, None, :] - Xv)
+        return np.mean(np.square(grad))
+
