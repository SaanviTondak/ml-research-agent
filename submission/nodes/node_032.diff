+class FM:
+    def __init__(self, num_features, k=16, lr=0.001, seed=0):
+        self.rng = np.random.default_rng(seed)
+        self.W = self.rng.normal(0, 0.01, size=(num_features,))
+        self.V = self.rng.normal(0, 0.01, size=(num_features, k))
+        self.b = 0.0
+        self.lr = lr
+
+    def predict(self, X):
+        linear = np.sum(self.W[X], axis=1) + self.b
+        v_sum = np.sum(self.V[X], axis=1)
+        v_sum_sq = np.sum(self.V[X] ** 2, axis=1)
+        interactions = 0.5 * np.sum(v_sum ** 2 - v_sum_sq, axis=1)
+        return 1.0 / (1.0 + np.exp(-(linear + interactions)))
+
+    def step(self, X, y):
+        preds = self.predict(X)
+        err = preds - y
+        batch_size = len(y)
+        for i in range(batch_size):
+            x_i = X[i]
+            e = err[i]
+            self.W[x_i] -= self.lr * e
+            v_x = self.V[x_i]
+            v_sum = np.sum(v_x, axis=0)
+            for f in x_i:
+                self.V[f] -= self.lr * e * (v_sum - self.V[f])
+            self.b -= self.lr * e
+        return np.mean(-y * np.log(np.clip(preds, 1e-7, 1 - 1e-7)) - (1 - y) * np.log(np.clip(1 - preds, 1e-7, 1 - 1e-7)))
 
